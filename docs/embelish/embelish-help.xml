  <command:command>
    <command:details>
      <command:name>Invoke-SevenZipCommand</command:name>
      <maml:description>
        <maml:para>Runs 7-Zip so it inherits the console, recording its exit code in
$script:LastSevenZipExit.</maml:para>
      </maml:description>
    </command:details>
    <maml:description>
      <maml:para>7-Zip writes its password prompt to stdout and only prompts when stdout
is a terminal. Any pipe, redirection or output capture here would hide
the prompt and deadlock, so 7-Zip must inherit this script's console and
its progress output necessarily shares that console. The exit code is
returned through a script variable rather than the pipeline to avoid
capturing (and thereby redirecting) that output.</maml:para>
    </maml:description>
    <command:syntax>
      <command:syntaxItem>
        <maml:name>Invoke-SevenZipCommand</maml:name>
        <command:parameter required="true" position="0">
          <maml:name>Executable</maml:name>
          <command:parameterValue required="true">String</command:parameterValue>
        </command:parameter>
        <command:parameter required="true" position="1">
          <maml:name>ArgumentList</maml:name>
          <command:parameterValue required="true">String[]</command:parameterValue>
        </command:parameter>
      </command:syntaxItem>
    </command:syntax>
